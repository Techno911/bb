+    }
+    if (/^<!doctype\b/iu.test(html.slice(cursor, cursor + 16))) {
+      return findTagEnd(html, cursor + 2);
+    }
+    return html.charCodeAt(0) === 0xfeff ? 1 : 0;
+  }
+  return html.charCodeAt(0) === 0xfeff ? 1 : 0;
