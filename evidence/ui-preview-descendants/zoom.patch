@@ -0,0 +1,40 @@
+import { describe, expect, it } from "vitest";
+import { getHtmlPreviewCameraToken, injectHtmlPreviewCameraBridge } from "../../src/services/hosts/html-preview-camera-bridge.js";
+
+const token = "123e4567-e89b-42d3-a456-426614174000";
+
+describe("HTML preview camera bridge", () => {
+  it.each([
+    ["doctype and comment", "<!doctype html><!-- <head> --><html><head><title>x</title></head></html>", 1],
+    ["script string", "<html><script>const sample = '<head>';</script><head></head></html>", 1],
+    ["fragment", "<main>fragment</main>", 1],
+  ])("inserts into a real HTML location for %s", (_name, html, expected) => {
+    const result = injectHtmlPreviewCameraBridge(html as string, token, "https://bb.test");
+    expect((result.content.match(/<script>\(\(\)=>/giu) ?? []).length).toBe(expected);
+    expect(result.sizeBytes).toBe(Buffer.byteLength(result.content));
+  });
+
+  it("keeps no-token HTML byte-identical and accepts only UUID tokens", () => {
+    const url = new URL("https://bb.test/file.html?__bbPreviewCamera=not-a-token");
+    expect(getHtmlPreviewCameraToken(url)).toBeUndefined();
+    const source = "<!doctype html><p>raw</p>";
+    expect(source).toBe("<!doctype html><p>raw</p>");
+  });
+
+  it("keeps relative resources intact and bounds source plus bootstrap size", () => {
+    const source = '<!doctype html><html><head><base href="./assets/"><link rel="stylesheet" href="site.css"></head></html>';
+    const result = injectHtmlPreviewCameraBridge(source, token, "https://bb.test");
+    expect(result.content).toContain('<base href="./assets/"><link rel="stylesheet" href="site.css">');
+    expect(result.sizeBytes - Buffer.byteLength(source)).toBeLessThan(4 * 1024);
+    expect(result.content).toContain("s('gesture-change'");
+    expect(() => injectHtmlPreviewCameraBridge("x".repeat(5 * 1024 * 1024 + 1), token, "https://bb.test")).toThrow(/5 MB/u);
+  });
+
+  it("inserts before source markup so RCDATA and inert template text cannot swallow the bridge", () => {
+    const source = '<!doctype html><textarea><head>value</textarea><template><head>inert</template><p>live</p>';
+    const result = injectHtmlPreviewCameraBridge(source, token, "https://bb.test");
+    expect(result.content).toContain(`<!doctype html><head><script>(()=>{const t="${token}"`);
+    expect(result.content).toContain(source.slice("<!doctype html>".length));
+    expect(result.content.indexOf("<script>")).toBeLessThan(result.content.indexOf("<textarea>"));
+  });
+});
