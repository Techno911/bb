diff --git a/packages/shared-ui/src/components/ui/preview-camera-math.ts b/packages/shared-ui/src/components/ui/preview-camera-math.ts
new file mode 100644
index 000000000..c845a9cb7
--- /dev/null
+++ b/packages/shared-ui/src/components/ui/preview-camera-math.ts
@@ -0,0 +1,99 @@
+export interface PreviewCameraPoint {
+  x: number;
+  y: number;
+}
+
+export interface PreviewCameraView {
+  offset: PreviewCameraPoint;
+  scale: number;
+}
+
+interface ZoomPreviewCameraArgs {
+  focalPoint: PreviewCameraPoint;
+  maxScale: number;
+  minScale: number;
+  nextScale: number;
+  view: PreviewCameraView;
+}
+
+interface PinchPreviewCameraArgs {
+  currentCenter: PreviewCameraPoint;
+  currentDistance: number;
+  maxScale: number;
+  minScale: number;
+  startCenter: PreviewCameraPoint;
+  startDistance: number;
+  startView: PreviewCameraView;
+}
+
+export function clampPreviewCameraScale({
+  maxScale,
+  minScale,
+  scale,
+}: {
+  maxScale: number;
+  minScale: number;
+  scale: number;
+}): number {
+  if (!Number.isFinite(scale)) return minScale;
+  return Math.min(maxScale, Math.max(minScale, scale));
+}
+
+export function zoomPreviewCamera({
+  focalPoint,
+  maxScale,
+  minScale,
+  nextScale,
+  view,
+}: ZoomPreviewCameraArgs): PreviewCameraView {
+  const clampedNextScale = clampPreviewCameraScale({
+    maxScale,
+    minScale,
+    scale: nextScale,
+  });
+  if (clampedNextScale === view.scale) return view;
+
+  const scaleRatio = clampedNextScale / view.scale;
+  return {
+    offset: {
+      x: focalPoint.x - scaleRatio * (focalPoint.x - view.offset.x),
+      y: focalPoint.y - scaleRatio * (focalPoint.y - view.offset.y),
+    },
+    scale: clampedNextScale,
+  };
+}
+
+export function pinchPreviewCamera({
+  currentCenter,
+  currentDistance,
+  maxScale,
+  minScale,
+  startCenter,
+  startDistance,
+  startView,
+}: PinchPreviewCameraArgs): PreviewCameraView {
+  if (
+    !Number.isFinite(startDistance) ||
+    !Number.isFinite(currentDistance) ||
+    startDistance <= 0 ||
+    currentDistance < 0
+  ) {
+    return startView;
+  }
+
+  const zoomedView = zoomPreviewCamera({
+    focalPoint: startCenter,
+    maxScale,
+    minScale,
+    nextScale: startView.scale * (currentDistance / startDistance),
+    view: startView,
+  });
+
+  return {
+    offset: {
+      x: zoomedView.offset.x + currentCenter.x - startCenter.x,
+      y: zoomedView.offset.y + currentCenter.y - startCenter.y,
+    },
+    scale: zoomedView.scale,
+  };
+}
