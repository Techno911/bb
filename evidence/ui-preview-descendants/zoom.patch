+      content,
+      contentEncoding: "utf8",
+      ...(metadata.mimeType !== null ? { mimeType: metadata.mimeType } : {}),
+      modifiedAtMs: metadata.modifiedAtMs,
+      sha256: createHash("sha256").update(content).digest("hex"),
+      sizeBytes: metadata.sizeBytes,
+    };
