+    if (metadata.sizeBytes > target.maxBytes) {
+      throw new ApiError(413, "file_too_large", "File exceeds the preview limit", false);
+    }
+    const chunks: Buffer[] = [];
+    for (let offset = 0; offset < metadata.sizeBytes; offset += HOST_FILE_CHUNK_MAX_BYTES) {
+      const length = Math.min(HOST_FILE_CHUNK_MAX_BYTES, metadata.sizeBytes - offset);
