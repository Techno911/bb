@@ -0,0 +1,70 @@
+import { z } from "zod";
+
+export const PREVIEW_CAMERA_BRIDGE_QUERY = "__bbPreviewCamera";
+export const PREVIEW_CAMERA_BRIDGE_VERSION = 1;
+export const PREVIEW_CAMERA_ZOOM_COMMAND_EVENT = "bb:preview-camera-zoom";
+export const previewCameraZoomCommandSchema = z.enum(["in", "out", "reset"]);
+
+const previewCameraCoordinateSchema = z.number().finite().min(-100_000).max(100_000);
+const previewCameraPointSchema = z
+  .object({
+    x: previewCameraCoordinateSchema,
+    y: previewCameraCoordinateSchema,
+  })
+  .strict();
+const previewCameraEnvelopeSchema = z.object({
+  token: z.string().uuid(),
+  version: z.literal(PREVIEW_CAMERA_BRIDGE_VERSION),
+});
+
+export const previewCameraBridgeMessageSchema = z.discriminatedUnion("type", [
+  previewCameraEnvelopeSchema.extend({
+    clientX: previewCameraCoordinateSchema,
+    clientY: previewCameraCoordinateSchema,
+    deltaMode: z.number().int().min(0).max(2),
+    deltaY: z.number().finite().min(-10_000).max(10_000),
+    type: z.literal("wheel"),
+  }).strict(),
+  previewCameraEnvelopeSchema.extend({
+    center: previewCameraPointSchema,
+    distance: z.number().finite().min(0).max(100_000),
+    type: z.literal("pinch-start"),
+  }).strict(),
+  previewCameraEnvelopeSchema.extend({
+    center: previewCameraPointSchema,
+    distance: z.number().finite().min(0).max(100_000),
+    type: z.literal("pinch-change"),
+  }).strict(),
+  previewCameraEnvelopeSchema.extend({
+    center: previewCameraPointSchema,
+    ratio: z.number().finite().min(0.01).max(100),
+    type: z.literal("gesture-change"),
+  }).strict(),
+  previewCameraEnvelopeSchema.extend({
+    type: z.literal("pinch-end"),
+  }).strict(),
+  previewCameraEnvelopeSchema.extend({
+    editable: z.boolean(),
+    key: z.enum(["+", "=", "-", "_", "0"]),
+    metaKey: z.boolean(),
+    ctrlKey: z.boolean(),
+    shiftKey: z.boolean(),
+    type: z.literal("key"),
+  }).strict(),
+  previewCameraEnvelopeSchema.extend({
+    editable: z.boolean(),
+    pressed: z.boolean(),
+    type: z.literal("space"),
+  }).strict(),
+]);
+
+export const previewCameraBridgeQuerySchema = z.object({
+  [PREVIEW_CAMERA_BRIDGE_QUERY]: z.string().uuid().optional(),
+});
+
+export type PreviewCameraBridgeMessage = z.infer<
+  typeof previewCameraBridgeMessageSchema
+>;
+export type PreviewCameraBridgeQuery = z.infer<
+  typeof previewCameraBridgeQuerySchema
+>;
