diff --git a/apps/desktop/src/preview-zoom-router.ts b/apps/desktop/src/preview-zoom-router.ts
new file mode 100644
index 000000000..c9b57c464
--- /dev/null
+++ b/apps/desktop/src/preview-zoom-router.ts
@@ -0,0 +1,35 @@
+import { PREVIEW_CAMERA_ZOOM_COMMAND_EVENT } from "@bb/server-contract";
+import type { BbDesktopZoomCommand } from "@bb/desktop-contract";
+import { nextZoomFactor } from "./desktop-zoom.js";
+
+interface ZoomTarget {
+  isDestroyed(): boolean;
+  executeJavaScript(code: string): Promise<unknown>;
+  getZoomFactor(): number;
+  setZoomFactor(factor: number): void;
+}
+
+export function createPreviewZoomRouter() {
+  const pending = new WeakMap<ZoomTarget, Promise<void>>();
+  return (
+    target: ZoomTarget | null | undefined,
+    command: BbDesktopZoomCommand,
+    isApplicationRenderer: boolean,
+  ): Promise<void> => {
+    if (!target || target.isDestroyed()) return Promise.resolve();
+    const run = async () => {
+      if (target.isDestroyed()) return;
+      let handled = false;
+      if (isApplicationRenderer) {
+        const code = `(() => { const event = new CustomEvent(${JSON.stringify(PREVIEW_CAMERA_ZOOM_COMMAND_EVENT)}, { cancelable: true, detail: ${JSON.stringify(command)} }); window.dispatchEvent(event); return event.defaultPrevented; })()`;
+        handled = (await target.executeJavaScript(code).catch(() => false)) === true;
+      }
+      if (!handled && !target.isDestroyed()) {
+        target.setZoomFactor(nextZoomFactor(target.getZoomFactor(), command));
+      }
+    };
+    const next = (pending.get(target) ?? Promise.resolve()).then(run);
+    pending.set(target, next);
+    return next;
+  };
+}
