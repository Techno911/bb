+        </Button>
+        <Button
+          aria-label="Fit to view"
+          className="h-9 px-2 text-xs"
+          disabled={view.scale === 1 && view.offset.x === 0 && view.offset.y === 0}
+          onClick={reset}
+          type="button"
+          variant="ghost"
+        >
+          Вписать
+        </Button>
+      </div>
+    </div>
+  );
+}
