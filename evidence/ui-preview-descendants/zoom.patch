@@ -0,0 +1,52 @@
+import { describe, expect, it, vi } from "vitest";
+import { createPreviewZoomRouter } from "../src/preview-zoom-router.js";
+
+function makeTarget(handled: boolean) {
+  let factor = 1;
+  return {
+    executeJavaScript: vi.fn(async () => handled),
+    isDestroyed: vi.fn(() => false),
+    getZoomFactor: () => factor,
+    setZoomFactor: vi.fn((value: number) => { factor = value; }),
+  };
+}
+
+describe("preview zoom routing", () => {
+  it("keeps page zoom unchanged when the focused camera accepts the command", async () => {
+    const target = makeTarget(true);
+    await createPreviewZoomRouter()(target, "in", true);
+    expect(target.getZoomFactor()).toBe(1);
+    expect(target.setZoomFactor).not.toHaveBeenCalled();
+  });
+
+  it("uses global zoom outside a preview and never executes code in a BrowserView", async () => {
+    const route = createPreviewZoomRouter();
+    const application = makeTarget(false);
+    await route(application, "in", true);
+    expect(application.getZoomFactor()).toBe(1.1);
+    const browser = makeTarget(true);
+    await route(browser, "out", false);
+    expect(browser.getZoomFactor()).toBe(0.9);
+    expect(browser.executeJavaScript).not.toHaveBeenCalled();
+  });
+
+  it("serializes repeated commands and handles navigation or destruction", async () => {
+    const target = makeTarget(false);
+    let finish: ((value: boolean) => void) | undefined;
+    target.executeJavaScript.mockImplementationOnce(() => new Promise<boolean>((resolve) => { finish = resolve; }));
+    const route = createPreviewZoomRouter();
+    const first = route(target, "in", true);
+    const second = route(target, "reset", true);
+    await vi.waitFor(() => expect(finish).toBeDefined());
+    expect(target.executeJavaScript).toHaveBeenCalledTimes(1);
+    finish!(false);
+    await Promise.all([first, second]);
+    expect(target.getZoomFactor()).toBe(1);
+    target.executeJavaScript.mockRejectedValueOnce(new Error("navigation"));
+    await route(target, "out", true);
+    expect(target.getZoomFactor()).toBe(0.9);
+    target.isDestroyed.mockReturnValue(true);
+    await route(target, "in", true);
+    expect(target.getZoomFactor()).toBe(0.9);
+  });
+});
