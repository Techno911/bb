+export async function readBoundedDaemonFileContent(
+  deps: LoggedWorkSessionDeps,
+  target: { hostId: string; path: string; rootPath: string; maxBytes: number },
+): Promise<Exclude<HostReadFileResult, { notModified: true }>> {
+  const read = (offset: number, length: number, revision: string | null) =>
+    callHostRetryableOnlineRpc(deps, {
+      hostId: target.hostId,
+      timeoutMs: COMMAND_TIMEOUT_MS,
+      command: {
+        type: "host.read_file_chunk",
+        path: target.path,
+        rootPath: target.rootPath,
+        offset,
+        length,
+        revision,
+      },
+    });
